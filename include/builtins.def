// id, special-form flag, fixed arity (-1 means variadic), native callback.
// Special forms are handled by the evaluator/lowerer and have no callback.
X(ADD,         0, -1, builtin_add)
X(AND,         1, -1, NULL)
X(APPLY,       1, -1, NULL)
X(CAR,         0,  1, builtin_car)
X(CDR,         0,  1, builtin_cdr)
X(CONS,        0,  2, builtin_cons)
X(DEFINE,      1,  2, NULL)
X(DIV,         0, -1, builtin_div)
X(EQ,          0,  2, builtin_eq)
X(NUM_EQ,      0, -1, builtin_num_eq)
X(ERROR,       0,  1, builtin_error)
X(EVAL,        1,  1, NULL)
X(FUNCALL,     1, -1, NULL)
X(GT,          0, -1, builtin_gt)
X(IF,          1, -1, NULL)
X(INTEGER_P,   0,  1, builtin_type_predicate)
X(NUMBER_P,    0,  1, builtin_type_predicate)
X(PAIR_P,      0,  1, builtin_type_predicate)
X(PROCEDURE_P, 0,  1, builtin_type_predicate)
X(SYMBOL_P,    0,  1, builtin_type_predicate)
X(LET,         1, -1, NULL)
X(LT,          0, -1, builtin_lt)
X(MUL,         0, -1, builtin_mul)
X(OR,          1, -1, NULL)
X(PRINT,       0,  1, builtin_print)
X(PROGN,       1, -1, NULL)
X(SET,         1,  2, NULL)
X(STRING,      0,  1, builtin_string)
X(SUB,         0, -1, builtin_sub)
